"""
Dockerfile.backend — Sovereign Workbench Backend Container
"""
FROM python:3.11-slim

WORKDIR /app

# System deps for psycopg binary, qrcode, bcrypt
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY models_config.json .
COPY config_loader.py .
COPY tool_interface.py .
COPY tools/ ./tools/
COPY orchestrator/ ./orchestrator/
COPY router/ ./router/
COPY scripts/ ./scripts/

# Create non-root user
RUN useradd -m -u 1000 sovereign && \
    mkdir -p /app/workspace /app/uploads /app/artifacts && \
    chown -R sovereign:sovereign /app

USER sovereign

EXPOSE 8000

# Run migrations then start server
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
