# ============================================================
# Sovereign Workbench — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sovereign_workbench
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# ─── JWT Authentication ──────────────────────────────────────
# REQUIRED. Must be at least 32 characters of high-entropy random data.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# The application will refuse to start if this is not set.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# JWT token lifetime in seconds (default: 8 hours)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=28800

# JWT refresh token lifetime in seconds (default: 7 days)
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ─── Application ────────────────────────────────────────────
APP_ENV=development
# Set to "production" for production deployments
# In production: DEBUG=false, enforce HTTPS, restrict CORS

DEBUG=true
LOG_LEVEL=INFO

# ─── Strict-Offline Mode ────────────────────────────────────
# When true: any attempt to reach an external host fails closed.
# Set to "true" for air-gapped or highly-confidential deployments.
STRICT_OFFLINE=false

# ─── Ollama ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Disable Ollama cloud features; all model inference stays local.
OLLAMA_NO_CLOUD=1

# ─── File Uploads ───────────────────────────────────────────
# Maximum file upload size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ─── Admin Bootstrap ────────────────────────────────────────
# Used only by scripts/setup_admin.py on first run.
# Remove after initial setup.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Rate Limiting ──────────────────────────────────────────
# Requests per minute on auth endpoints
RATE_LIMIT_AUTH_PER_MINUTE=10

# Requests per minute on agent/ingest endpoints
RATE_LIMIT_AGENT_PER_MINUTE=30

# ─── Account Lockout ────────────────────────────────────────
# Number of consecutive failed logins before temporary lockout
MAX_FAILED_LOGIN_ATTEMPTS=5

# Lockout duration in seconds
ACCOUNT_LOCKOUT_SECONDS=900
