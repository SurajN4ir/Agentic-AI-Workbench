{
  "version": "1.0.0",
  "dataset_id": "sovereign_quantitative_eval_dataset_v1",
  "description": "Deterministic quantitative benchmark specification suite for Sovereign AI Workbench",
  "ground_truth_file": "eval/dataset/quantitative_ground_truth.json",
  "test_suites": {
    "ocr_suite": {
      "metric_types": ["CER", "WER"],
      "fixtures": [
        {
          "fixture_id": "ocr_clean_plate",
          "file_path": "eval/fixtures/ocr/clean_specification_plate.png",
          "ground_truth_key": "clean_specification_plate.png",
